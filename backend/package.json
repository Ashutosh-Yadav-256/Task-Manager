{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for the MERN Task Manager",
  "main": "server.js",
  "scripts": {
    "start": "nodemon server.js",
    "test": "jest --testPathIgnorePatterns=contract --runInBand --detectOpenHandles --forceExit",
    "test:contract:consumer": "jest __tests__/contract/tasks.consumer.pact.test.js --runInBand --forceExit",
    "test:contract:provider": "jest __tests__/contract/tasks.provider.pact.test.js --runInBand --forceExit",
    "test:contract": "npm run test:contract:consumer && npm run test:contract:provider",
    "test:all": "npm test && npm run test:contract"
  },
  "keywords": [
    "mern",
    "task-manager",
    "jest",
    "supertest"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.3"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^17.1.4",
    "jest": "^29.7.0",
    "nodemon": "^2.0.22",
    "supertest": "^7.0.0"
  }
}
