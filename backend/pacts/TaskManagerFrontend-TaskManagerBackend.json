{
  "consumer": {
    "name": "TaskManagerFrontend"
  },
  "interactions": [
    {
      "description": "a request for all user tasks",
      "request": {
        "headers": {
          "x-auth-token": "valid-pact-jwt-token"
        },
        "method": "GET",
        "path": "/tasks"
      },
      "response": {
        "body": [
          {
            "_id": "60d21b4667d0d8992e610c85",
            "description": "Define interactions between consumer and provider",
            "dueDate": "2026-10-25T00:00:00.000Z",
            "priority": "High",
            "status": "In Progress",
            "title": "Complete PACT Contract Testing",
            "user": "60d21b4667d0d8992e610c80"
          }
        ],
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*]._id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].description": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].dueDate": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].priority": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].user": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a valid login request",
